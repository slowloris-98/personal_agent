# Copy to `.env` and fill in the key for whichever LLM provider you select in config.yaml.
# The default provider is `claude_code`, which needs NO key (uses your local `claude` CLI).

# Anthropic API (provider: anthropic)
ANTHROPIC_API_KEY=

# OpenAI (provider: openai). ALSO required by the memory layer (Cognee) when
# memory.enabled is true in config.yaml — Cognee uses it for graph-building and
# embeddings, regardless of which LLM provider you pick above.
OPENAI_API_KEY=

# Groq (provider: groq)
GROQ_API_KEY=
