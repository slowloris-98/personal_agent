# Copy to `.env` and fill in the key for whichever LLM provider you select in config.yaml.
# The default provider is `claude_code`, which needs NO key (uses your local `claude` CLI).

# Anthropic API (provider: anthropic)
ANTHROPIC_API_KEY=

# OpenAI (provider: openai)
OPENAI_API_KEY=

# Groq (provider: groq)
GROQ_API_KEY=

# notion API
NOTION_API_KEY=

# --- Responder / communication layer (optional; only if responder.enabled) ---
# Shared secret between the PC (push) and the phone (ingest endpoint). Set the SAME
# value in both machines' .env. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
INGEST_TOKEN=
# Telegram bot token from @BotFather (phone only).
TELEGRAM_BOT_TOKEN=
# Local LLM host, only if responder.provider = ollama (defaults to http://localhost:11434).
OLLAMA_HOST=